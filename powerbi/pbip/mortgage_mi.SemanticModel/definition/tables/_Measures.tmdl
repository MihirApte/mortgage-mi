	measure 'Outstanding Balance PQ' = ```
			
			VAR d = [Prior Quarter Date]
			RETURN
			    CALCULATE (
			        SUM ( fact_mortgage_measure[value] ),
			        dim_measure[measure_code] = "OUTSTANDING_BALANCE",
