	measure 'Arrears Rate (Accounts)' = ```
			
			DIVIDE ( [Arrears Accounts], [Outstanding Accounts] )
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: a8e4c831-e736-43d4-8bc0-f1ff54f57b0a

	measure 'Arrears Rate (Balance)' = ```
			
