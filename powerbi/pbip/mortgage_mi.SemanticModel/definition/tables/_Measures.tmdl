table _Measures
	lineageTag: ad1ebefa-0c54-4211-bd29-78ed83b85785

	measure 'Latest Complete Quarter Date' =
			
			CALCULATE (
			    MAX ( dim_date[quarter_end_date] ),
			    REMOVEFILTERS ( dim_date ),
			    dim_date[is_latest_complete_quarter] = TRUE ()
			)
		formatString: General Date
		lineageTag: a1a25136-e38f-416b-8359-e7deba90d994

	measure 'Report Date' =
			
			IF (
			    HASONEVALUE ( dim_date[quarter_end_date] ),
			    MAX ( dim_date[quarter_end_date] ),
			    [Latest Complete Quarter Date]
			)
		formatString: General Date
		lineageTag: f7b8a32b-c985-4572-8e8c-b597b97531d0

	measure 'Reporting Quarter Label' =
			
			LOOKUPVALUE ( dim_date[quarter_label], dim_date[quarter_end_date], [Report Date] )
		lineageTag: 99807ac4-86ad-484e-9f96-37f19f5753b7

	measure 'Prior Quarter Date' = ```
			
			VAR d = [Report Date]
			VAR pk = LOOKUPVALUE ( dim_date[prior_quarter_key], dim_date[quarter_end_date], d )
			RETURN
			    LOOKUPVALUE ( dim_date[quarter_end_date], dim_date[date_key], pk )
			
			```
		formatString: General Date
		lineageTag: 32710f9b-8a8a-427f-a0c3-3f2c56d7008e

	measure 'Is Complete Quarter' = ```
			
			LOOKUPVALUE ( dim_date[is_complete_quarter], dim_date[quarter_end_date], [Report Date] )
			
			```
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 748dd8aa-a09c-453e-960a-440aa18d5e29

	measure 'Arrears Accounts' = ```
			
			VAR d = [Report Date]
			RETURN
			    CALCULATE (
			        SUM ( fact_mortgage_measure[value] ),
			        dim_measure[measure_code] = "ARREARS_ACCOUNTS",
			        REMOVEFILTERS ( dim_date ),
			        dim_date[quarter_end_date] = d
			    )
			
			```
		formatString: #,0
		lineageTag: 2e142966-0115-4f19-97dd-854984cc66cd

	measure 'Outstanding Accounts' = ```
			
			VAR d = [Report Date]
