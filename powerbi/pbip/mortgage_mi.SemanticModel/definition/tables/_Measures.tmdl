	measure 'Arrears Accounts PQ' =
			
			VAR d = [Prior Quarter Date]
			RETURN
			    CALCULATE (
			        SUM ( fact_mortgage_measure[value] ),
			        dim_measure[measure_code] = "ARREARS_ACCOUNTS",
			        REMOVEFILTERS ( dim_date ),
			        dim_date[quarter_end_date] = d
			    )
		formatString: 0
		lineageTag: 6ad07d9a-4b7e-4545-8e7d-5109a05f5469

	measure 'Outstanding Accounts PQ' = ```
			
			VAR d = [Prior Quarter Date]
			RETURN
			    CALCULATE (
			        SUM ( fact_mortgage_measure[value] ),
			        dim_measure[measure_code] = "OUTSTANDING_ACCOUNTS",
			        REMOVEFILTERS ( dim_date ),
